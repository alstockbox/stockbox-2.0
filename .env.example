# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=StockBox
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing - active release catalog
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_COUPON_BASIC_LAUNCH=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_COUPON_STANDARD_LAUNCH=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_COUPON_PREMIUM_LAUNCH=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_COUPON_AFFILIATE_10=

# Affiliate payouts / scheduled operations
AFFILIATE_CONNECT_ENABLED=false
CRON_SECRET=

# Legal seller identity - required for paid launch
LEGAL_BUSINESS_NAME=
LEGAL_ORGANIZATION_NUMBER=
LEGAL_POSTAL_ADDRESS=
LEGAL_SUPPORT_EMAIL=
LEGAL_SUPPORT_PHONE=
# small_business_exempt or vat_registered
LEGAL_VAT_MODE=
LEGAL_VAT_NUMBER=

# Core financial data providers
SEC_USER_AGENT=
# IMPORTANT: use only market/estimates plans whose licenses permit StockBox's commercial end-user display.
MARKET_DATA_PROVIDER=twelve_data
MARKET_DATA_FALLBACK_PROVIDERS=stooq
GLOBAL_SYMBOL_SEARCH_PROVIDER=disabled
# Analyst estimates/revisions are intentionally opt-in because they may consume premium provider credits.
ESTIMATES_PROVIDER=disabled
TWELVE_DATA_API_KEY=

# Official-source enrichment
# Riksbanken SWEA: key may be optional depending on the access tier/environment.
RIKSBANK_API_KEY=
# OpenFIGI works without a key at lower limits; a key raises mapping limits.
OPENFIGI_API_KEY=
# Bolagsverket Värdefulla datamängder: request free test/production credentials from Bolagsverket.
# Use the exact OAuth token URL, API base URL and scope supplied for your environment.
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
BOLAGSVERKET_TOKEN_URL=
BOLAGSVERKET_BASE_URL=
BOLAGSVERKET_SCOPE=

# News / AI (deferred unless explicitly enabled)
NEWS_PROVIDER=disabled
NEWS_API_KEY=
AI_PROVIDER=disabled
AI_PROVIDER_API_KEY=
AI_MODEL_SUMMARY=

# Email - Resend is required for paid launch withdrawal receipts
EMAIL_PROVIDER=resend
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_ALERT_EMAIL=

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Admin bootstrap
ADMIN_EMAILS=
