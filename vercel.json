{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "crons": [
    {
      "path": "/api/jobs/alpha/scan/run",
      "schedule": "20 2 * * 1-5"
    },
    {
      "path": "/api/jobs/alpha/outcomes/run",
      "schedule": "0 3 * * 1-5"
    },
    {
      "path": "/api/monitoring/run",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/integrations/smb-os/sync",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/affiliate/payouts/run",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/jobs/batch/run",
      "schedule": "15 4 * * *"
    }
  ]
}
