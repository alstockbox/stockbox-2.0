{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "stockbox-3.0": false
    }
  },
  "crons": [
    {
      "path": "/api/monitoring/run",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/affiliate/payouts/run",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/jobs/batch/run",
      "schedule": "15 4 * * *"
    }
  ]
}
